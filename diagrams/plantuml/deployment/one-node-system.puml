@startuml one-node-system
!include ../_includes/theme.puml

' One node: the main loop in its root directory with the process registry,
' its own board and its system roles, the session host, several processes
' (each its own repository with exactly one root orchestrator), the
' operator's private files, the person's own backup remote, and the person
' reaching the main loop through channels and the companion app.
' Sources: main loop spec DRAFT v0.1 §3, §5, §6.2, §10, §11, §12;
' curator-playbook process configuration DRAFT v3.5 §2.1, §2.3, §6.5.

title One node: the main loop and its processes
caption Sources: main loop DRAFT v0.2 §3, §5, §6.2, §10, §11, §12; process configuration v3.5 §2.1, §2.3, §6.5

hide stereotype

skinparam component<<service>> {
  BackgroundColor $SERVICE
  BorderColor $SERVICE_LINE
}
skinparam rectangle<<agent>> {
  BackgroundColor $AGENT
  BorderColor $AGENT_LINE
}
skinparam collections<<agent>> {
  BackgroundColor $AGENT
  BorderColor $AGENT_LINE
}
skinparam file<<committed>> {
  BackgroundColor $COMMITTED
  BorderColor $COMMITTED_LINE
}
skinparam database<<committed>> {
  BackgroundColor $COMMITTED
  BorderColor $COMMITTED_LINE
}
skinparam file<<private>> {
  BackgroundColor $PRIVATE
  BorderColor $PRIVATE_LINE
}
skinparam cloud<<private>> {
  BackgroundColor $PRIVATE
  BorderColor $PRIVATE_LINE
}
skinparam actor<<person>> {
  BackgroundColor $PERSON
  BorderColor $PERSON_LINE
}
skinparam rectangle<<person>> {
  BackgroundColor $PERSON
  BorderColor $PERSON_LINE
}
skinparam queue<<carrier>> {
  BackgroundColor $CARRIER
  BorderColor $CARRIER_LINE
}

actor "Person" as person <<person>>
rectangle "Companion app\n(phone or computer)" as app <<person>>
cloud "The person's own git remote\n(backup; never ours)" as remote <<private>>

node "Node: one machine" as node {

  folder "Root directory (the person's git repository)" as root {
    rectangle "Main loop session\nkeeper skill + <i>keeper</i> command" as mainloop <<agent>>
    collections "System roles in the main loop's process:\ndesigner, librarian,\nsysadmin (backup, tokens, updates),\nwatchdog (context and limits,\nfrom session-host telemetry)" as sysroles <<agent>>
    file registry <<committed>> [
      <b>keeper.toml</b>: process registry
      ----
      <b>Playbook.json</b>: the main loop's own process
      ----
      <b>Skillfile.json</b>: one entry, the keeper package
      (board tool, session-host tooling, roles, profiles)
    ]
    database "Main loop board:\nrequests and answers" as rootboard <<committed>>
  }

  component "Session host\n(session registry,\ncapability tokens)" as sessionhost <<service>>
  queue "waggle local carrier\n(mailboxes)" as carrier <<carrier>>

  frame "Process: family calendar" as procCal {
    rectangle "Root orchestrator\n(exactly one)" as rootCal <<agent>>
    collections "Sub-orchestrators and runs" as runsCal <<agent>>
    database "Board" as boardCal <<committed>>
  }

  frame "Process: café" as procCafe {
    rectangle "Root orchestrator\n(exactly one)" as rootCafe <<agent>>
    collections "Sub-orchestrators and runs" as runsCafe <<agent>>
    database "Board" as boardCafe <<committed>>
  }

  file operatorfiles <<private>> [
    <b><U+007E>/.curator/</b>: models, runtimes, engines, network
    (the operator's, never committed)
    ----
    keychain: tokens (never in git)
  ]
}

person --> mainloop : terminal (keeper, keeper chat)\nor messenger channel
app <..> mainloop : approvals and\nconfirmations (signed)
app <..> sysroles : secrets moved only over\nthe paired channel (sysadmin)

mainloop --> registry : reads, proposes changes\n(confirmed by a person)
mainloop --> rootboard : records requests
mainloop --> sysroles : runs on schedule\nand on demand
mainloop --> sessionhost : up, wake, park, stop\nroot orchestrators
mainloop --> carrier : coord requests
carrier --> rootCal : doorbell, pull
carrier --> rootCafe : doorbell, pull
rootCafe ..> carrier : results, questions\nfor the person

sessionhost --> rootCal : hosts
sessionhost --> rootCafe : hosts

sysroles ..> remote : backup of the root and\nprocess repositories (sysadmin)

rootCal --> runsCal : spawns inside\nits process
rootCafe --> runsCafe : spawns inside\nits process
rootCal --> boardCal : writes
rootCafe --> boardCafe : writes

procCafe .right.> procCal : hand-off only

legend right
  <b>Invariants</b>
  • The main loop starts only root orchestrators.
  • It never writes a process's board.
  • Processes are separate repositories,
    reached only by hand-off.
  • Registry changes take effect
    after a person confirms them.
  • System roles hold no secrets;
    trusted executors do the privileged steps.
endlegend

@enduml
